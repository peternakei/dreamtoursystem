APP_NAME="Dream Travel and Tours"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_TIMEZONE=Africa/Dar_es_Salaam
APP_URL=http://127.0.0.1:8001

# Public-facing marketing/customer site (separate from this backend).
# Used for guest-facing itinerary and booking links rendered in PDFs and share drafts.
PUBLIC_SITE_URL=https://www.serenbluesafaris.com

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
APP_MAINTENANCE_STORE=database

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=dreamtours_main
DB_USERNAME=root
DB_PASSWORD=

# Optional separate activity, request and error log database. Leave LOGS_DB_DATABASE empty to use the main connection.
LOGS_DB_CONNECTION=mysql
LOGS_DB_HOST=127.0.0.1
LOGS_DB_PORT=3306
LOGS_DB_DATABASE=
LOGS_DB_USERNAME=root
LOGS_DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_ENCRYPTION=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="Dream Travel and Tours"

SELCOM_VENDOR=
SELCOM_KEY=
SELCOM_SECRET=
SELCOM_BASE_URL=https://apigw.selcommobile.com/v1
SELCOM_REDIRECT_URL=
SELCOM_CANCEL_URL=
SELCOM_WEBHOOK="${APP_URL}/v2/payments/callback"
SELCOM_ORDER_EXPIRY=15
SELCOM_PAYMENT_METHODS=ALL # ALL, MASTERPASS, CARD, MOBILEMONEYPULL

# Quotation PDF rendering. "browsershot" requires Node + Puppeteer/Chrome on
# the server (`npm install puppeteer` at project root, or set PDF_CHROME_PATH).
# When Browsershot fails the service automatically falls back to DomPDF.
PDF_DRIVER=dompdf
PDF_NODE_BINARY=
PDF_NPM_BINARY=
PDF_CHROME_PATH=
PDF_NODE_INCLUDE_PATH=
PDF_WAIT_UNTIL=networkidle0
PDF_TIMEOUT_MS=60000
PDF_FORMAT=A4
PDF_MARGIN_TOP=8
PDF_MARGIN_RIGHT=8
PDF_MARGIN_BOTTOM=10
PDF_MARGIN_LEFT=8

SESSION_COOKIE=dreamtoursystem_session
