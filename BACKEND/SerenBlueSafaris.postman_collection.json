{
  "info": {
    "name": "Seren Blue Safaris API",
    "_postman_id": "b1a9f7d2-0001-4a00-9c22-serenblue0001",
    "description": "Full API collection for Seren Blue Safaris backend (Laravel + Sanctum).\n\n## Setup\n1. Import `SerenBlueSafaris.postman_environment.json` and select it.\n2. Set `base_url` (e.g. http://localhost:8000/api).\n3. Run **Auth → Login** — token, user_uuid, and other ids are auto-saved to the environment.\n4. Subsequent protected requests read `{{token}}` automatically from collection-level Bearer auth.\n\nAll requests use `Accept: application/json`. Dynamic fields (uuids, ids) are captured from responses via test scripts where sensible.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "auth": {
    "type": "bearer",
    "bearer": [{ "key": "token", "value": "{{token}}", "type": "string" }]
  },
  "event": [
    {
      "listen": "prerequest",
      "script": {
        "type": "text/javascript",
        "exec": [
          "// Global pre-request: ensure base_url exists and normalise it",
          "let baseUrl = pm.environment.get('base_url') || pm.collectionVariables.get('base_url');",
          "if (!baseUrl) {",
          "    baseUrl = 'http://localhost:8000/api';",
          "    pm.environment.set('base_url', baseUrl);",
          "}",
          "// strip trailing slash",
          "if (baseUrl.endsWith('/')) {",
          "    baseUrl = baseUrl.slice(0, -1);",
          "    pm.environment.set('base_url', baseUrl);",
          "}",
          "const ensure = (key, value) => { if (!pm.environment.get(key)) pm.environment.set(key, value); };",
          "const fmt = (date) => [date.getFullYear(), String(date.getMonth() + 1).padStart(2, '0'), String(date.getDate()).padStart(2, '0')].join('-');",
          "const start = new Date();",
          "start.setDate(start.getDate() + 14);",
          "const end = new Date(start);",
          "end.setDate(end.getDate() + 5);",
          "ensure('travel_date', fmt(start));",
          "ensure('travel_end_date', fmt(end));",
          "ensure('item_type', 'trip');",
          "ensure('trip_type_id', '1');",
          "ensure('cartable_type', pm.environment.get('item_type'));",
          "ensure('like_type', pm.environment.get('item_type'));",
          "const itemType = pm.environment.get('item_type') || 'trip';",
          "const itemUuid = itemType === 'destination' ? pm.environment.get('destination_uuid') : pm.environment.get('trip_uuid');",
          "if (itemUuid) {",
          "    pm.environment.set('item_uuid', itemUuid);",
          "    pm.environment.set('cartable_uuid', itemUuid);",
          "    pm.environment.set('likeable_uuid', itemUuid);",
          "    pm.environment.set('rateable_uuid', itemUuid);",
          "}",
          "// generate a per-request idempotency key if needed",
          "pm.variables.set('request_id', pm.variables.replaceIn('{{$guid}}'));"
        ]
      }
    },
    {
      "listen": "test",
      "script": {
        "type": "text/javascript",
        "exec": [
          "// Global test: auto-capture token & common ids from any response",
          "try {",
          "    const res = pm.response.json();",
          "    const data = res && (res.data || res);",
          "    if (!data) return;",
          "",
          "    const pickToken = (o) => o && (o.token || o.access_token || (o.user && (o.user.token || o.user.access_token)) || (o.data && (o.data.token || o.data.access_token)));",
          "    const token = pickToken(res) || pickToken(data);",
          "    if (token && typeof token === 'string') {",
          "        pm.environment.set('token', token);",
          "        console.log('✔ token saved');",
          "    }",
          "",
          "    const u = (data && data.user) || res.user;",
          "    if (u) {",
          "        if (u.uuid) pm.environment.set('user_uuid', u.uuid);",
          "        if (u.id)   pm.environment.set('user_id', u.id);",
          "        if (u.email) pm.environment.set('user_email', u.email);",
          "    }",
          "} catch (e) { /* non-JSON response — ignore */ }"
        ]
      }
    }
  ],
  "variable": [
    { "key": "base_url", "value": "http://localhost:8000/api" }
  ],
  "item": [
    {
      "name": "Splash",
      "item": [
        {
          "name": "Get Splash",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('200 OK', () => pm.response.to.have.status(200));",
                  "try {",
                  "    const d = pm.response.json().data || {};",
                  "    if (d.locations && d.locations[0]) pm.environment.set('location_id', d.locations[0].id);",
                  "    if (d.currencies && d.currencies[0]) { pm.environment.set('currency_id', d.currencies[0].id); if (d.currencies[0].uuid) pm.environment.set('currency_uuid', d.currencies[0].uuid); }",
                  "    if (d.countries && d.countries[0])  pm.environment.set('country_id',  d.countries[0].id);",
                  "    if (d.categories && d.categories[0]) pm.environment.set('category_id', d.categories[0].id);",
                  "    if (d.seasons && d.seasons[0]) pm.environment.set('season_id', d.seasons[0].id);",
                  "    if (d.searviceClasses && d.searviceClasses[0]) pm.environment.set('service_class_id', d.searviceClasses[0].id);",
                  "    if (d.genders && d.genders[0]) pm.environment.set('gender_id', d.genders[0].id);",
                  "    if (d.paymentModes && d.paymentModes[0]) pm.environment.set('payment_mode_id', d.paymentModes[0].id);",
                  "} catch (e) {}"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [{ "key": "Accept", "value": "application/json" }],
            "url": { "raw": "{{base_url}}/splash", "host": ["{{base_url}}"], "path": ["splash"] }
          }
        }
      ]
    },
    {
      "name": "Authentication",
      "item": [
        {
          "name": "Register",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('register success', () => pm.expect([200,201]).to.include(pm.response.code));",
                  "try {",
                  "    const r = pm.response.json();",
                  "    const t = (r.data && (r.data.token || (r.data.user && r.data.user.token))) || r.token;",
                  "    if (t) pm.environment.set('token', t);",
                  "    const u = (r.data && r.data.user) || r.user;",
                  "    if (u && u.uuid) pm.environment.set('user_uuid', u.uuid);",
                  "} catch (e) {}"
                ]
              }
            }
          ],
          "request": {
            "auth": { "type": "noauth" },
            "method": "POST",
            "header": [
              { "key": "Accept", "value": "application/json" },
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": { "mode": "raw", "raw": "{\n  \"name\": \"{{full_name}}\",\n  \"phone\": \"{{user_phone}}\",\n  \"email\": \"{{user_email}}\",\n  \"country\": {{country_id}},\n  \"address\": \"{{user_address}}\",\n  \"gender\": {{gender_id}},\n  \"password\": \"{{user_password}}\",\n  \"confirm-password\": \"{{user_password}}\"\n}" },
            "url": { "raw": "{{base_url}}/register", "host": ["{{base_url}}"], "path": ["register"] }
          }
        },
        {
          "name": "Login",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('login 200', () => pm.response.to.have.status(200));",
                  "try {",
                  "    const r = pm.response.json();",
                  "    const t = (r.data && (r.data.token || (r.data.user && r.data.user.token))) || r.token || r.access_token;",
                  "    if (t) { pm.environment.set('token', t); console.log('✔ token saved to environment'); }",
                  "    const u = (r.data && r.data.user) || r.user;",
                  "    if (u) {",
                  "        if (u.uuid)  pm.environment.set('user_uuid', u.uuid);",
                  "        if (u.id)    pm.environment.set('user_id', u.id);",
                  "        if (u.email) pm.environment.set('user_email', u.email);",
                  "    }",
                  "} catch (e) { console.warn('login test: ', e.message); }"
                ]
              }
            }
          ],
          "request": {
            "auth": { "type": "noauth" },
            "method": "POST",
            "header": [
              { "key": "Accept", "value": "application/json" },
              { "key": "Content-Type", "value": "application/json" }
